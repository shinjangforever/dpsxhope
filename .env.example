# คัดลอกเป็น .env ที่ root ของ repo แล้วใส่เฉพาะค่าที่ใช้
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# เปลี่ยนรุ่นโมเดลได้ที่นี่ โดยไม่ต้องแก้โค้ด
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.5-flash

# RAG: anthropic หรือ ollama
LLM_PROVIDER=anthropic
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# RAG
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=4
RAG_USE_RERANK=false

# Agent
AGENT_MAX_TURNS=8

# API
HOST=127.0.0.1
PORT=3000
APP_API_KEY=
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
SYSTEM_PROMPT=You are a helpful assistant.
ALLOW_CLIENT_SYSTEM=false
